# Server
PORT=5000
JWT_SECRET=your-jwt-secret

# Database
DB_HOST=localhost
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Email (Resend)
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=info@evobrand.net

# Stripe
STRIPE_SECRET_KEY=sk_your-key

# Google AI
GOOGLE_AI_API_KEY=your-key

# Google Analytics 4 Data API
# Property ID from GA4 Admin → Property Settings
GA_PROPERTY_ID=540387549
# Service account JSON key (stringify the entire JSON on one line)
GA_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
