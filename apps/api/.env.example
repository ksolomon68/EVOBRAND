# Server
PORT=5000
JWT_SECRET=your-jwt-secret

# Database
DB_HOST=localhost
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Email (Resend)
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=info@evobrand.net

# Stripe
STRIPE_SECRET_KEY=sk_your-key

# Google AI
GOOGLE_AI_API_KEY=your-key

# Google Calendar Sync (bidirectional: EVOBRAND bookings push to Google, and any event on
# this Google Calendar — including ones created outside EVOBRAND — blocks that time on the site)
# Create OAuth2 credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Enable the Google Calendar API, create an OAuth 2.0 Client ID (type: Web application)
# Then run the one-time auth flow to get a refresh token (see docs/google-calendar-setup.md)
GOOGLE_CLIENT_ID=your-oauth2-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth2-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Leave blank to use your primary calendar, or set a specific calendar ID
GOOGLE_CALENDAR_ID=primary
