# ============================================================
#  EVOBRAND WordPress Maintenance System — Environment Config
# ============================================================

# ─── Email (Nodemailer) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@evobrand.com
SMTP_PASS=your-app-password

# From address shown to recipients
EMAIL_FROM_NAME=EVOBRAND Maintenance Team
EMAIL_FROM_ADDRESS=maintenance@evobrand.com

# ─── Puppeteer / PDF ─────────────────────────────────────────
# Override Puppeteer executable path if needed (optional)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# ─── WP-CLI ──────────────────────────────────────────────────
# Default WP-CLI binary path (override per-client in clients.json)
WPCLI_BIN=wp

# ─── Scheduling (node-cron) ──────────────────────────────────
# Cron expression — default: every Sunday at 2:00 AM
CRON_SCHEDULE=0 2 * * 0

# Set to "true" to enable cron mode on startup
CRON_ENABLED=false

# ─── Reporting ───────────────────────────────────────────────
# Base URL for branded report assets (optional CDN override)
REPORT_BASE_URL=

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
