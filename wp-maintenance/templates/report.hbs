<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WordPress Maintenance Report — {{clientName}}</title>
  <style>
    /* ── Google Fonts ── */
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    /* ── Design Tokens ── */
    :root {
      --cyan:        #22c8e5;
      --cyan-light:  #d6f5fa;
      --cyan-mid:    #a8edf5;
      --deep-blue:   #003258;
      --blue-mid:    #004a80;
      --white:       #ffffff;
      --off-white:   #f8f9fb;
      --gray-50:     #f4f6f8;
      --gray-100:    #eaecef;
      --gray-300:    #c8cdd4;
      --gray-500:    #6b7280;
      --gray-700:    #374151;
      --gray-900:    #111827;
      --radius:      8px;
      --shadow-sm:   0 1px 3px rgba(0,50,88,0.08);
      --shadow-md:   0 4px 16px rgba(0,50,88,0.10);
    }

    /* ── Reset ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Base ── */
    html { font-size: 16px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--off-white);
      color: var(--gray-700);
      line-height: 1.65;
      min-height: 100vh;
    }

    /* ── Page Wrapper ── */
    .page {
      max-width: 860px;
      margin: 0 auto;
      background: var(--white);
      box-shadow: var(--shadow-md);
    }

    /* ════════════════════════════════════════════════
       HEADER
    ════════════════════════════════════════════════ */
    .header {
      background: var(--deep-blue);
      padding: 0;
      position: relative;
      overflow: hidden;
    }
    .header::after {
      content: '';
      position: absolute;
      top: 0; right: 0;
      width: 340px; height: 100%;
      background: linear-gradient(135deg, transparent 40%, rgba(34,200,229,0.12) 100%);
      pointer-events: none;
    }
    .header-inner {
      padding: 40px 52px 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .logo-block {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .logo-mark {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--cyan) 0%, #0fa8c4 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .logo-mark svg { width: 26px; height: 26px; }
    .logo-text {
      display: flex;
      flex-direction: column;
    }
    .logo-name {
      font-size: 20px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 0.04em;
      line-height: 1.1;
    }
    .logo-tagline {
      font-size: 10px;
      font-weight: 400;
      color: rgba(255,255,255,0.5);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-top: 3px;
    }
    .header-badge {
      text-align: right;
    }
    .report-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--cyan);
      margin-bottom: 4px;
    }
    .report-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--white);
      line-height: 1.2;
    }

    /* ── Cyan accent bar ── */
    .accent-bar {
      height: 3px;
      background: linear-gradient(90deg, var(--cyan) 0%, #0fa8c4 60%, var(--deep-blue) 100%);
    }

    /* ════════════════════════════════════════════════
       CLIENT META STRIP
    ════════════════════════════════════════════════ */
    .meta-strip {
      background: var(--gray-50);
      border-bottom: 1px solid var(--gray-100);
      padding: 20px 52px;
      display: flex;
      gap: 48px;
    }
    .meta-item {}
    .meta-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gray-500);
      margin-bottom: 4px;
    }
    .meta-value {
      font-size: 15px;
      font-weight: 600;
      color: var(--gray-900);
    }

    /* ════════════════════════════════════════════════
       CONTENT AREA
    ════════════════════════════════════════════════ */
    .content {
      padding: 48px 52px;
    }

    /* ── Section ── */
    .section { margin-bottom: 44px; }
    .section:last-child { margin-bottom: 0; }

    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }
    .section-icon {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: var(--cyan-light);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .section-icon svg {
      width: 16px;
      height: 16px;
      stroke: var(--cyan);
    }
    .section-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--deep-blue);
      letter-spacing: -0.01em;
    }
    .section-divider {
      height: 1px;
      background: var(--gray-100);
      margin-bottom: 24px;
    }

    /* ════════════════════════════════════════════════
       SUMMARY CARDS
    ════════════════════════════════════════════════ */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 0;
    }
    .summary-card {
      background: var(--gray-50);
      border: 1px solid var(--gray-100);
      border-radius: var(--radius);
      padding: 22px 24px;
      position: relative;
      overflow: hidden;
    }
    .summary-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--cyan), var(--deep-blue));
    }
    .card-value {
      font-size: 32px;
      font-weight: 700;
      color: var(--deep-blue);
      line-height: 1;
      margin-bottom: 6px;
    }
    .card-label {
      font-size: 12px;
      font-weight: 500;
      color: var(--gray-500);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .card-status-ok {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      color: #059669;
      margin-top: 8px;
    }
    .card-status-ok::before {
      content: '';
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #10b981;
      display: block;
    }
    .card-status-warn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      color: #d97706;
      margin-top: 8px;
    }
    .card-status-warn::before {
      content: '';
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #f59e0b;
      display: block;
    }

    /* ════════════════════════════════════════════════
       PLUGINS TABLE
    ════════════════════════════════════════════════ */
    .table-wrap {
      border-radius: var(--radius);
      border: 1px solid var(--gray-100);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
    }
    thead {
      background: var(--deep-blue);
    }
    thead th {
      padding: 14px 18px;
      text-align: left;
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.7);
    }
    thead th:last-child { text-align: center; }
    tbody tr {
      border-bottom: 1px solid var(--gray-100);
      transition: background 0.15s;
    }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:nth-child(even) { background: var(--gray-50); }
    tbody td {
      padding: 14px 18px;
      vertical-align: middle;
      color: var(--gray-700);
    }
    tbody td:last-child { text-align: center; }
    .plugin-name {
      font-weight: 600;
      color: var(--gray-900);
      margin-bottom: 2px;
    }
    .plugin-slug {
      font-size: 11.5px;
      color: var(--gray-500);
    }
    .version-change {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
      font-size: 12.5px;
    }
    .version-old { color: var(--gray-500); }
    .version-arrow {
      color: var(--cyan);
      font-size: 14px;
    }
    .version-new {
      color: var(--deep-blue);
      font-weight: 600;
    }
    .badge-updated {
      display: inline-block;
      background: var(--cyan-light);
      color: #0890a8;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 20px;
      border: 1px solid var(--cyan-mid);
    }
    .no-updates-row td {
      text-align: center;
      padding: 36px 18px;
      color: var(--gray-500);
      font-style: italic;
    }

    /* ════════════════════════════════════════════════
       RECOMMENDATIONS
    ════════════════════════════════════════════════ */
    .rec-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .rec-item {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      background: var(--gray-50);
      border: 1px solid var(--gray-100);
      border-radius: var(--radius);
      padding: 14px 18px;
    }
    .rec-icon {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--cyan) 0%, #0fa8c4 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .rec-icon svg {
      width: 12px;
      height: 12px;
      stroke: white;
      stroke-width: 2.5;
    }
    .rec-text {
      font-size: 13.5px;
      color: var(--gray-700);
      line-height: 1.6;
    }

    /* ════════════════════════════════════════════════
       FOOTER
    ════════════════════════════════════════════════ */
    .footer {
      background: var(--deep-blue);
      padding: 28px 52px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer-left {
      font-size: 12px;
      color: rgba(255,255,255,0.45);
    }
    .footer-right {
      font-size: 11px;
      font-weight: 600;
      color: var(--cyan);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* ════════════════════════════════════════════════
       PRINT / PDF OVERRIDES
    ════════════════════════════════════════════════ */
    @media print {
      body { background: white; }
      .page { box-shadow: none; max-width: 100%; }
      tbody tr:hover { background: inherit; }
    }
  </style>
</head>
<body>
  <div class="page">

    <!-- ════ HEADER ════ -->
    <header class="header">
      <div class="header-inner">
        <div class="logo-block">
          <div class="logo-mark">
            <!-- EVOBRAND Logomark -->
            <svg viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 13L13 3L23 13L13 23L3 13Z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
              <path d="M8 13L13 8L18 13L13 18L8 13Z" fill="white"/>
            </svg>
          </div>
          <div class="logo-text">
            <span class="logo-name">EVOBRAND</span>
            <span class="logo-tagline">Digital Strategy &amp; Solutions</span>
          </div>
        </div>
        <div class="header-badge">
          <div class="report-label">Maintenance Report</div>
          <div class="report-title">WordPress Update<br>Summary</div>
        </div>
      </div>
    </header>
    <div class="accent-bar"></div>

    <!-- ════ META STRIP ════ -->
    <div class="meta-strip">
      <div class="meta-item">
        <div class="meta-label">Client</div>
        <div class="meta-value">{{clientName}}</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Report Date</div>
        <div class="meta-value">{{reportDate}}</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Prepared By</div>
        <div class="meta-value">EVOBRAND</div>
      </div>
    </div>

    <!-- ════ CONTENT ════ -->
    <main class="content">

      <!-- ── Summary ── -->
      <section class="section">
        <div class="section-header">
          <div class="section-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
          </div>
          <h2 class="section-title">Maintenance Summary</h2>
        </div>
        <div class="section-divider"></div>
        <div class="summary-grid">
          <div class="summary-card">
            <div class="card-value">{{totalUpdated}}</div>
            <div class="card-label">Plugins Updated</div>
          </div>
          <div class="summary-card">
            <div class="card-value">{{totalPlugins}}</div>
            <div class="card-label">Total Plugins</div>
          </div>
          <div class="summary-card">
            <div class="card-value" style="font-size:20px; margin-top:4px;">
              {{#if isHealthy}}
                <span style="color:#059669;">Healthy</span>
              {{else}}
                <span style="color:#d97706;">Review</span>
              {{/if}}
            </div>
            <div class="card-label">Site Status</div>
            {{#if isHealthy}}
              <div class="card-status-ok">All Systems Operational</div>
            {{else}}
              <div class="card-status-warn">Attention Required</div>
            {{/if}}
          </div>
        </div>
      </section>

      <!-- ── Updated Plugins Table ── -->
      <section class="section">
        <div class="section-header">
          <div class="section-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/>
              <polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/>
            </svg>
          </div>
          <h2 class="section-title">Updated Plugins</h2>
        </div>
        <div class="section-divider"></div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Plugin</th>
                <th>Version Change</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {{#if hasUpdates}}
                {{#each updatedPlugins}}
                <tr>
                  <td>
                    <div class="plugin-name">{{this.title}}</div>
                    <div class="plugin-slug">{{this.name}}</div>
                  </td>
                  <td>
                    <div class="version-change">
                      <span class="version-old">{{this.oldVersion}}</span>
                      <span class="version-arrow">→</span>
                      <span class="version-new">{{this.newVersion}}</span>
                    </div>
                  </td>
                  <td>
                    <span class="badge-updated">Updated</span>
                  </td>
                </tr>
                {{/each}}
              {{else}}
                <tr class="no-updates-row">
                  <td colspan="3">All plugins were already up to date — no changes required.</td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ── Recommendations ── -->
      <section class="section">
        <div class="section-header">
          <div class="section-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </div>
          <h2 class="section-title">Recommendations</h2>
        </div>
        <div class="section-divider"></div>
        <ul class="rec-list">
          {{#each recommendations}}
          <li class="rec-item">
            <div class="rec-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <span class="rec-text">{{this}}</span>
          </li>
          {{/each}}
        </ul>
      </section>

    </main>

    <!-- ════ FOOTER ════ -->
    <footer class="footer">
      <div class="footer-left">
        This report was automatically generated by the EVOBRAND Maintenance System.<br>
        Confidential — prepared exclusively for {{clientName}}.
      </div>
      <div class="footer-right">evobrand.com</div>
    </footer>

  </div>
</body>
</html>
