<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. If the request is NOT already for the build folder
    RewriteCond %{REQUEST_URI} !^/dist/apps/web/
    
    # 2. Rewrite it to the build folder
    # This makes evobrandconcepts.com/ serve from dist/apps/web/
    RewriteRule ^(.*)$ dist/apps/web/$1 [L]
</IfModule>
